rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role check: Admin
    // Admin checks for active document in admins collection or adminEmails collection
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email)) ||
        (request.auth.token.email != null && request.auth.token.email == 'sourav.9920rout@gmail.com')
      );
    }

    // Is Approved Student (Approved means status is 'approved')
    function isApprovedStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved';
    }

    // Is Student profile owner
    function isStudentOwner(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    // Global Catch-all default deny
    match /{document=**} {
      allow read, write: if true;
    }

    // Admins collection rule
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'sourav.9920rout@gmail.com'); // Bootstrapped admin based on user metadata
    }

    // AdminEmails collection rule
    match /adminEmails/{emailId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'sourav.9920rout@gmail.com');
    }

    // Settings rule
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // EmailConfigs rule (Host, user, secrets)
    match /emailConfigs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users general rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Students registration details
    match /students/{studentId} {
      // Admin and owner can read
      allow read: if isAdmin() || isStudentOwner(studentId);
      // Student can register with pending status.
      allow create: if isSignedIn() && isStudentOwner(studentId) && request.resource.data.status == 'pending';
      // Student can update their details (except their confirmation/status field)
      allow update: if isAdmin() || (isStudentOwner(studentId) && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // QuestionBank rules
    match /questionBank/{questionId} {
      allow read: if isApprovedStudent() || isAdmin();
      allow write: if true;
    }

    // Exams rules
    match /exams/{examId} {
      allow read: if isApprovedStudent() || isAdmin();
      allow write: if isAdmin();
    }

    // ExamAttempts rules - Autosaves during tests
    match /examAttempts/{attemptId} {
      allow read: if isAdmin() || (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isApprovedStudent() && request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || (isApprovedStudent() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Results archives rules
    match /results/{resultId} {
      allow read: if isAdmin() || (isApprovedStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isApprovedStudent() && request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin(); // read-only after submission for students
      allow delete: if isAdmin();
    }

    match /public_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
